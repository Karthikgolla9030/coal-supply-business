# ─────────────────────────────────────────────
# Application
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────
# Database — PostgreSQL
# Create the database in pgAdmin before running migrations.
# ─────────────────────────────────────────────
DB_NAME=coal_invoice_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────────────
# CORS — allowed frontend origins (comma-separated)
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────────────────────────
# Google Drive PDF Storage
# ─────────────────────────────────────────────
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=backend/credentials/google-service-account.json
